#!/usr/bin/env bash
# Toggle the OPTCG overlay on macOS (bind this to a hotkey).
# usage: optcg [box]        optcg --ipc COMMAND [ARG]
# Works through symlinks (e.g. ln -s .../mac/optcg ~/bin/optcg).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK="$(readlink "$SOURCE")"
    [[ "$LINK" = /* ]] && SOURCE="$LINK" || SOURCE="$(dirname "$SOURCE")/$LINK"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
    echo "Not installed yet -- run $DIR/install.sh first." >&2
    exit 1
fi
exec "$DIR/.venv/bin/python" "$DIR/optcg.py" "$@"
